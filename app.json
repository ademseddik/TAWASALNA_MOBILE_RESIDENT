{
  "expo": {
    "name": "TAWASALNA",
    "slug": "TAWASALNA",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Icons/logoc.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/Icons/logoc.png",
      "resizeMode": "contain",
      "backgroundColor": "#900562"
    },
    "ios": {
      "supportsTablet": true,
      "splash": {
        "resizeMode": "contain",
        "image": "./assets/Icons/logoc.png",
        "backgroundColor": "#2A003A"
      }
    },
    "android": {
     


      "permissions": [
        "INTERNET",
        "CAMERA"
      ],
      "splash": {
        "resizeMode": "contain",
        "image": "./assets/Icons/logoc.png",
        "backgroundColor": "#900562"
      },
      "package": "com.adem1.TAWASALNA"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-localization",
      "expo-secure-store",
      [
        "expo-barcode-scanner",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access camera to scan QR codes."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "39ac4e1b-45e6-49ab-ab00-f2bd3f15f08e"
      }
    }
  }
}